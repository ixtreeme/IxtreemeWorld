rml,
body {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    background-color: transparent;
}

body {
    font-family: "Roboto";
    font-size: 16px;
    color: #f4f7fb;
}

.menu-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.42);
}

.menu-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 300px;
    height: 286px;
    margin-left: -150px;
    margin-top: -143px;
    padding: 24px;
    background-color: rgba(18, 24, 45, 0.94);
    border-width: 1px;
    border-color: rgba(220, 232, 255, 0.22);
    border-radius: 8px;
}

h2 {
    margin: 0 0 22px 0;
    text-align: center;
    font-size: 24px;
    font-weight: normal;
    color: #ffffff;
}

button {
    width: 100%;
    height: 42px;
    margin-bottom: 12px;
    border-width: 1px;
    border-radius: 6px;
    color: #ffffff;
    font-size: 15px;
}

.primary-button {
    background-color: #347fe8;
    border-color: #6aa7ff;
}

.primary-button:hover {
    background-color: #4291ff;
}

.secondary-button {
    background-color: rgba(255, 255, 255, 0.10);
    border-color: rgba(255, 255, 255, 0.24);
}

.secondary-button:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.danger-button {
    background-color: rgba(185, 55, 55, 0.72);
    border-color: rgba(230, 92, 92, 0.58);
}

.danger-button:hover {
    background-color: rgba(220, 68, 68, 0.88);
}
