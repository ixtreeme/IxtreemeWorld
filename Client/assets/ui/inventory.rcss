rml,
body {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    background-color: transparent;
}

body {
    font-family: "Roboto";
    font-size: 14px;
    color: #f4f7fb;
}

.inventory-window {
    position: absolute;
    right: 32px;
    top: 92px;
    width: 348px;
    padding: 18px;
    background-color: rgba(18, 24, 45, 0.94);
    border-width: 1px;
    border-color: rgba(220, 232, 255, 0.22);
    border-radius: 8px;
}

.title-row {
    height: 38px;
    margin-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(220, 232, 255, 0.14);
}

h2 {
    display: inline-block;
    width: 244px;
    margin: 0;
    font-size: 21px;
    font-weight: normal;
}

.close-button {
    width: 78px;
    height: 30px;
    background-color: rgba(255, 255, 255, 0.10);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.24);
    border-radius: 6px;
    color: #ffffff;
}

.inventory-grid {
    width: 336px;
}

.slot {
    display: inline-block;
    width: 48px;
    height: 48px;
    margin-right: 6px;
    margin-bottom: 6px;
    background-color: rgba(0, 0, 0, 0.38);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 5px;
}

.slot:hover {
    border-color: rgba(255, 215, 0, 0.65);
    background-color: rgba(255, 255, 255, 0.08);
}

.status-text {
    margin: 10px 0 0 0;
    color: #b8c1d1;
    text-align: center;
    font-size: 12px;
}
