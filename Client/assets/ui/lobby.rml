<rml>
<head>
    <title>Lobby - AURIGA GLOBAL</title>
    <link type="text/rcss" href="lobby.rcss" />
</head>
<body>
    <div class="lobby-screen">
        <div class="lobby-background"></div>

        <div class="character-panel">
            <h2 class="panel-title">Characters</h2>
            <div id="character-list" class="character-list"></div>
            <button id="new-character-btn" class="secondary-button">+ New Character</button>
        </div>

        <div class="action-panel">
            <div id="selected-char-info" class="selected-char-info">
                <h3 id="selected-char-name" class="char-name-big">No character selected</h3>
                <div id="selected-char-meta" class="char-meta-big"></div>
            </div>

            <div class="action-buttons">
                <button id="enter-world-btn" class="primary-button" disabled="disabled">ENTER WORLD</button>
                <button id="delete-char-btn" class="danger-button" disabled="disabled">Delete Character</button>
            </div>

            <div id="error-message" class="error-text"></div>
        </div>

        <button id="logout-btn" class="logout-button">Logout</button>

        <div id="delete-confirm" class="modal-overlay">
            <div class="modal-panel">
                <h3>Delete Character?</h3>
                <p>This action cannot be undone. The character will be permanently removed.</p>
                <div class="modal-buttons">
                    <button id="confirm-delete-yes" class="danger-button">Yes, Delete</button>
                    <button id="confirm-delete-no" class="secondary-button">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
