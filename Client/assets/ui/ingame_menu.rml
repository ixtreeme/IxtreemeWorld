<rml>
<head>
    <title>In Game Menu</title>
    <link type="text/rcss" href="ingame_menu.rcss" />
</head>
<body>
    <div class="menu-screen">
        <div class="menu-panel">
            <h2>Game Menu</h2>
            <button id="menu-resume-btn" class="primary-button">Resume</button>
            <button id="menu-settings-btn" class="secondary-button">Settings</button>
            <button id="menu-logout-btn" class="secondary-button">Logout</button>
            <button id="menu-quit-btn" class="danger-button">Quit Game</button>
        </div>
    </div>
</body>
</rml>
