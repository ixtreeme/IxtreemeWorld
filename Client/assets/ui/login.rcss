rml,
body {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    margin: 0;
}

body {
    font-family: "Roboto";
    font-size: 16px;
    color: #f4f7fb;
}

.login-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #101c2e;
}

.login-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 360px;
    height: 372px;
    margin-left: -180px;
    margin-top: -186px;
    padding: 28px;
    background-color: #171b2a;
    border-width: 1px;
    border-color: #a7afbd;
    border-radius: 8px;
}

h1 {
    margin: 0 0 26px 0;
    text-align: center;
    font-size: 28px;
    font-weight: normal;
    color: #f9fafb;
}

.field {
    margin-bottom: 16px;
}

label {
    display: block;
    margin-bottom: 7px;
    color: #c9d0dc;
    font-size: 14px;
}

input {
    width: 100%;
    height: 40px;
    padding: 0 10px;
    background-color: #232c3d;
    border-width: 1px;
    border-color: #53627a;
    border-radius: 5px;
    color: #ffffff;
    font-size: 16px;
}

input:focus {
    border-color: #77a9ff;
}

.remember-row {
    margin-top: 4px;
    margin-bottom: 22px;
    height: 24px;
}

.remember-row input {
    display: inline-block;
    width: 18px;
    height: 18px;
    margin-right: 10px;
    vertical-align: middle;
}

.remember-row label {
    display: inline-block;
    margin: 0;
    vertical-align: middle;
    color: #eef2f7;
}

.login-button {
    width: 100%;
    height: 46px;
    background-color: #347fe8;
    border-width: 1px;
    border-color: #5fa0ff;
    border-radius: 5px;
    color: #ffffff;
    font-size: 16px;
}

.login-button:hover {
    background-color: #4291ff;
}

.login-button:active {
    background-color: #2568c7;
}

.login-error {
    display: none;
    margin: 14px 0 0 0;
    color: #ffb4b4;
    text-align: center;
    font-size: 14px;
}
