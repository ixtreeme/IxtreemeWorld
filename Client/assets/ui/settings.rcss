rml,
body {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    background-color: transparent;
}

body {
    font-family: "Roboto";
    font-size: 15px;
    color: #f4f7fb;
}

.settings-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.46);
}

.settings-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 560px;
    height: 430px;
    margin-left: -280px;
    margin-top: -215px;
    padding: 24px;
    background-color: rgba(18, 24, 45, 0.96);
    border-width: 1px;
    border-color: rgba(220, 232, 255, 0.22);
    border-radius: 8px;
}

.title-row {
    height: 42px;
    margin-bottom: 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(220, 232, 255, 0.14);
}

h2 {
    display: inline-block;
    width: 430px;
    margin: 0;
    font-size: 24px;
    font-weight: normal;
}

.close-button {
    width: 88px;
    height: 32px;
    background-color: rgba(255, 255, 255, 0.10);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.24);
    border-radius: 6px;
    color: #ffffff;
}

.tab-row {
    height: 40px;
    margin-bottom: 16px;
}

.tab-button {
    display: inline-block;
    width: 172px;
    height: 34px;
    margin-right: 8px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    color: #d4d9e4;
}

.tab-button.active {
    background-color: rgba(74, 144, 226, 0.36);
    border-color: #6aa7ff;
    color: #ffffff;
}

.settings-page {
    height: 206px;
}

.hidden {
    display: none;
}

.setting-row {
    height: 44px;
    margin-bottom: 10px;
    padding: 10px 12px;
    background-color: rgba(0, 0, 0, 0.28);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    border-radius: 6px;
}

.setting-label {
    display: inline-block;
    width: 230px;
    color: #c9d0dc;
}

.setting-value {
    display: inline-block;
    width: 270px;
    color: #ffffff;
    text-align: right;
}

.apply-button {
    width: 100%;
    height: 42px;
    background-color: #347fe8;
    border-width: 1px;
    border-color: #6aa7ff;
    border-radius: 6px;
    color: #ffffff;
    font-size: 15px;
}

.status-text {
    margin: 12px 0 0 0;
    color: #9fca86;
    text-align: center;
    font-size: 13px;
}
