rml,
body {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    background-color: transparent;
}

body {
    font-family: "Roboto";
    font-size: 16px;
    color: #f4f7fb;
}

.hud-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: transparent;
}

.player-frame {
    position: absolute;
    left: 20px;
    top: 20px;
    width: 280px;
    padding: 14px;
    background-color: rgba(0, 0, 0, 0.62);
    border-width: 1px;
    border-color: rgba(220, 232, 255, 0.18);
    border-radius: 8px;
}

.player-header {
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(220, 232, 255, 0.12);
}

.player-name {
    display: inline-block;
    width: 210px;
    font-size: 15px;
    font-weight: bold;
    color: #ffffff;
}

.player-level {
    display: inline-block;
    width: 56px;
    text-align: right;
    font-size: 13px;
    color: #ffd700;
}

.bar-container {
    margin-bottom: 8px;
}

.bar-label {
    margin-bottom: 3px;
    font-size: 11px;
}

.bar-name {
    display: inline-block;
    width: 40px;
    color: #b8c1d1;
}

.bar-value {
    display: inline-block;
    width: 220px;
    text-align: right;
    color: #ffffff;
}

.bar-track {
    width: 100%;
    height: 14px;
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    overflow: hidden;
}

.bar-fill {
    width: 100%;
    height: 100%;
}

.health-fill {
    background-color: #c93636;
}

.mana-fill {
    background-color: #347fe8;
}

.exp-container .bar-track {
    height: 8px;
}

.exp-fill {
    background-color: #d6b31c;
}

.target-frame {
    display: none;
    position: absolute;
    right: 20px;
    top: 20px;
    width: 260px;
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.62);
    border-width: 1px;
    border-color: rgba(255, 120, 120, 0.48);
    border-radius: 8px;
}

.target-header {
    margin-bottom: 8px;
}

.target-name {
    display: inline-block;
    width: 188px;
    font-size: 14px;
    font-weight: bold;
    color: #ff9a9a;
}

.target-level {
    display: inline-block;
    width: 54px;
    text-align: right;
    font-size: 12px;
    color: #d4d9e4;
}

.target-hp-text {
    display: block;
    margin-top: 3px;
    font-size: 11px;
    color: #ffffff;
    text-align: center;
}

.minimap-frame {
    position: absolute;
    right: 20px;
    bottom: 20px;
    width: 220px;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.62);
    border-width: 1px;
    border-color: rgba(220, 232, 255, 0.18);
    border-radius: 8px;
}

.minimap-header {
    text-align: center;
    margin-bottom: 8px;
}

.zone-name {
    font-size: 12px;
    font-weight: bold;
    color: #ffd700;
}

.minimap-canvas {
    position: relative;
    width: 200px;
    height: 200px;
    margin-left: 9px;
    background-color: rgba(20, 32, 55, 0.82);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
}

.minimap-crosshair {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.10);
}

.minimap-crosshair.horizontal {
    left: 12px;
    top: 100px;
    width: 176px;
    height: 1px;
}

.minimap-crosshair.vertical {
    left: 100px;
    top: 12px;
    width: 1px;
    height: 176px;
}

.minimap-player-dot {
    position: absolute;
    left: 96px;
    top: 96px;
    width: 8px;
    height: 8px;
    background-color: #ffd700;
    border-radius: 4px;
}

.minimap-coords {
    text-align: center;
    margin-top: 8px;
    font-size: 11px;
    color: #b8c1d1;
}
