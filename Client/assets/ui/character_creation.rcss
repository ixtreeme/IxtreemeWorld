rml,
body {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    background-color: transparent;
}

body {
    font-family: "Roboto";
    font-size: 15px;
    color: #f4f7fb;
}

.creation-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.46);
}

.creation-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 420px;
    height: 340px;
    margin-left: -210px;
    margin-top: -170px;
    padding: 26px;
    background-color: rgba(18, 24, 45, 0.96);
    border-width: 1px;
    border-color: rgba(220, 232, 255, 0.22);
    border-radius: 8px;
}

h2 {
    margin: 0 0 22px 0;
    text-align: center;
    font-size: 24px;
    font-weight: normal;
}

.field {
    margin-bottom: 18px;
}

label {
    display: block;
    margin-bottom: 7px;
    color: #c9d0dc;
}

input {
    width: 100%;
    height: 38px;
    padding: 0 10px;
    background-color: #232c3d;
    border-width: 1px;
    border-color: #53627a;
    border-radius: 5px;
    color: #ffffff;
    font-size: 15px;
}

.class-row {
    height: 38px;
}

.class-button {
    display: inline-block;
    width: 125px;
    height: 34px;
    margin-right: 8px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    color: #d4d9e4;
}

.class-button.selected {
    background-color: rgba(74, 144, 226, 0.36);
    border-color: #6aa7ff;
    color: #ffffff;
}

.status-text {
    height: 24px;
    margin: 6px 0 14px 0;
    color: #ffcf70;
    text-align: center;
    font-size: 13px;
}

.button-row button {
    display: inline-block;
    width: 197px;
    height: 40px;
    margin-right: 8px;
    border-width: 1px;
    border-radius: 6px;
    color: #ffffff;
}

.primary-button {
    background-color: #347fe8;
    border-color: #6aa7ff;
}

.secondary-button {
    background-color: rgba(255, 255, 255, 0.10);
    border-color: rgba(255, 255, 255, 0.24);
}
