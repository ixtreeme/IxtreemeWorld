<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  TextElement.FontFamily="assets/fonts/#Roboto"
  Background="#00000000">

  <Grid.Resources>
    <Style x:Key="EditorButton" TargetType="Button">
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinWidth" Value="58"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="Background" Value="#FF26354A"/>
      <Setter Property="BorderBrush" Value="#66758AA8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Chrome"
              CornerRadius="4"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FF334762"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FF1C2738"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="EditorRadio" TargetType="RadioButton">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="Background" Value="#FF202B3A"/>
      <Setter Property="BorderBrush" Value="#55758AA8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border
              x:Name="Chrome"
              CornerRadius="4"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FF2B3B52"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FF2F7DF6"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF8FB9FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Border
    Width="306"
    HorizontalAlignment="Right"
    VerticalAlignment="Top"
    Margin="0,28,24,0"
    CornerRadius="6"
    Padding="16"
    Background="#DD111820"
    BorderBrush="#66758AA8"
    BorderThickness="1">
    <StackPanel>
      <TextBlock
        Text="Map Editor"
        FontSize="19"
        FontWeight="Bold"
        Foreground="#FFFFFFFF"
        Margin="0,0,0,12"/>

      <UniformGrid Columns="2">
        <RadioButton x:Name="ToolRaise" Content="Raise" GroupName="EditorTool" Style="{StaticResource EditorRadio}"/>
        <RadioButton x:Name="ToolLower" Content="Lower" GroupName="EditorTool" Style="{StaticResource EditorRadio}"/>
        <RadioButton x:Name="ToolSmooth" Content="Smooth" GroupName="EditorTool" Style="{StaticResource EditorRadio}"/>
        <RadioButton x:Name="ToolFlatten" Content="Flatten" GroupName="EditorTool" Style="{StaticResource EditorRadio}"/>
        <RadioButton x:Name="ToolPaint" Content="Paint" GroupName="EditorTool" Style="{StaticResource EditorRadio}"/>
      </UniformGrid>

      <TextBlock Text="Radius" FontSize="12" Foreground="#FFB8C0CF" Margin="0,8,0,2"/>
      <Slider x:Name="BrushRadiusSlider" Minimum="1" Maximum="50" Value="5"/>

      <TextBlock Text="Strength" FontSize="12" Foreground="#FFB8C0CF" Margin="0,10,0,2"/>
      <Slider x:Name="BrushStrengthSlider" Minimum="0.1" Maximum="5" Value="1"/>

      <Grid Margin="0,12,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Texture" FontSize="13" Foreground="#FFFFFFFF"/>
        <TextBlock x:Name="TextureSlotText" Grid.Column="1" FontSize="13" Foreground="#FF79C8FF"/>
      </Grid>

      <UniformGrid Columns="4">
        <Button x:Name="Tex0Button" Content="0" Style="{StaticResource EditorButton}"/>
        <Button x:Name="Tex1Button" Content="1" Style="{StaticResource EditorButton}"/>
        <Button x:Name="Tex2Button" Content="2" Style="{StaticResource EditorButton}"/>
        <Button x:Name="Tex3Button" Content="3" Style="{StaticResource EditorButton}"/>
        <Button x:Name="Tex4Button" Content="4" Style="{StaticResource EditorButton}"/>
        <Button x:Name="Tex5Button" Content="5" Style="{StaticResource EditorButton}"/>
        <Button x:Name="Tex6Button" Content="6" Style="{StaticResource EditorButton}"/>
        <Button x:Name="Tex7Button" Content="7" Style="{StaticResource EditorButton}"/>
      </UniformGrid>

      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="UndoButton" Grid.Column="0" Content="Undo" Style="{StaticResource EditorButton}"/>
        <Button x:Name="SaveButton" Grid.Column="1" Content="Save" Style="{StaticResource EditorButton}"/>
        <Button x:Name="ReloadButton" Grid.Column="2" Content="Reload" Style="{StaticResource EditorButton}"/>
      </Grid>
    </StackPanel>
  </Border>
</Grid>
