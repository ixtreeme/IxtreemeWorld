<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  TextElement.FontFamily="assets/fonts/#Roboto"
  Background="#00000000">

  <Grid.Resources>
    <SolidColorBrush x:Key="EditorPanelBackground" Color="#FF1E1E28"/>
    <SolidColorBrush x:Key="EditorPanelBorder" Color="#80FFFFFF"/>

    <Style TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
    </Style>

    <Style TargetType="RadioButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
    </Style>

    <Style TargetType="Slider">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
    </Style>

    <Style TargetType="TreeView">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="Background" Value="#001E1E28"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="EditorTreeViewItem" TargetType="TreeViewItem">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="Background" Value="#001E1E28"/>
      <Setter Property="Margin" Value="0,1,0,1"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <StackPanel>
              <Border
                x:Name="TreeItemChrome"
                CornerRadius="3"
                Padding="4,2"
                Background="{TemplateBinding Background}">
                <ContentPresenter
                  Content="{TemplateBinding Header}"
                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"/>
              </Border>
              <ItemsPresenter Margin="14,1,0,0"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TreeItemChrome" Property="Background" Value="#334762"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TreeItemChrome" Property="Background" Value="#FF26354A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="EditorButton" TargetType="Button">
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinWidth" Value="58"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="Background" Value="#FF26354A"/>
      <Setter Property="BorderBrush" Value="#66758AA8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Chrome"
              CornerRadius="4"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FF334762"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FF1C2738"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="EditorRadio" TargetType="RadioButton">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="Background" Value="#FF202B3A"/>
      <Setter Property="BorderBrush" Value="#55758AA8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border
              x:Name="Chrome"
              CornerRadius="4"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FF2B3B52"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FF2F7DF6"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF8FB9FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="EditorTextBox" TargetType="TextBox">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="Background" Value="#FF162231"/>
      <Setter Property="BorderBrush" Value="#55758AA8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="CaretBrush" Value="#FFFFFFFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border
              x:Name="Chrome"
              CornerRadius="3"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer
                x:Name="PART_ContentHost"
                Margin="{TemplateBinding Padding}"
                Background="#00000000"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#889AB4D6"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF2F7DF6"/>
                <Setter TargetName="Chrome" Property="Background" Value="#FF192638"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="EditorSliderRepeatButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="EditorSliderThumb" TargetType="Thumb">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border
              x:Name="Grip"
              Width="18"
              Height="18"
              CornerRadius="9"
              Background="#FFE8F2FF"
              BorderBrush="#FF79C8FF"
              BorderThickness="2"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Grip" Property="Background" Value="#FFFFFFFF"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Grip" Property="Background" Value="#FF79C8FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="EditorSlider" TargetType="Slider">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Margin" Value="0,0,6,8"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Background" Value="#FF111820"/>
      <Setter Property="Foreground" Value="#FF2F7DF6"/>
      <Setter Property="BorderBrush" Value="#66758AA8"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="34" Background="Transparent">
              <Border
                Height="10"
                VerticalAlignment="Center"
                CornerRadius="5"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1"/>
              <Track x:Name="PART_Track" Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Padding="0,12" Margin="0,0,-1,0" Background="{TemplateBinding Foreground}" Style="{StaticResource EditorSliderRepeatButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Padding="0,12" Background="Transparent" Style="{StaticResource EditorSliderRepeatButton}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource EditorSliderThumb}"/>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="320"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="320"/>
    </Grid.RowDefinitions>

    <Border
      x:Name="ToolsPanelBorder"
      Grid.Row="0"
      Grid.Column="0"
      Margin="0,16,12,12"
      CornerRadius="6"
      Padding="14"
      Background="{StaticResource EditorPanelBackground}"
      BorderBrush="{StaticResource EditorPanelBorder}"
      BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Tools" FontSize="19" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,12"/>

          <UniformGrid Columns="2">
            <RadioButton x:Name="ToolRaise" Content="Raise" GroupName="EditorTool" Style="{StaticResource EditorRadio}"/>
            <RadioButton x:Name="ToolLower" Content="Lower" GroupName="EditorTool" Style="{StaticResource EditorRadio}"/>
            <RadioButton x:Name="ToolSmooth" Content="Smooth" GroupName="EditorTool" Style="{StaticResource EditorRadio}"/>
            <RadioButton x:Name="ToolFlatten" Content="Flatten" GroupName="EditorTool" Style="{StaticResource EditorRadio}"/>
            <RadioButton x:Name="ToolPaint" Content="Paint" GroupName="EditorTool" Style="{StaticResource EditorRadio}"/>
          </UniformGrid>

          <Button x:Name="AddMarkerButton" Content="+ Marker" Style="{StaticResource EditorButton}"/>
          <Button x:Name="AddWaterBodyButton" Content="+ Water" Style="{StaticResource EditorButton}"/>
          <TextBlock Text="Lighting" FontSize="13" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,10,0,4"/>
          <Button x:Name="LightingButton" Content="Lighting" Style="{StaticResource EditorButton}"/>

          <TextBlock x:Name="BrushRadiusText" Text="Radius: 5.0 m" FontSize="12" Foreground="#FFB8C0CF" Margin="0,8,0,2"/>
          <Slider x:Name="BrushRadiusSlider" Minimum="0.5" Maximum="50" Value="5" Style="{StaticResource EditorSlider}"/>

          <TextBlock x:Name="BrushStrengthText" Text="Strength: 1.0" FontSize="12" Foreground="#FFB8C0CF" Margin="0,10,0,2"/>
          <Slider x:Name="BrushStrengthSlider" Minimum="0.1" Maximum="5" Value="1" Style="{StaticResource EditorSlider}"/>

          <Grid Margin="0,14,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Active Slot" FontSize="13" Foreground="#FFFFFFFF"/>
            <TextBlock x:Name="TextureSlotText" Grid.Column="1" FontSize="13" Foreground="#FF79C8FF"/>
          </Grid>

          <Grid Margin="0,2,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Paint Mode:" FontSize="12" Foreground="#FFB8C0CF" VerticalAlignment="Center" Margin="0,0,8,6"/>
            <RadioButton x:Name="PaintModeReplace" Grid.Column="1" Content="Replace" GroupName="PaintMode" Style="{StaticResource EditorRadio}" IsChecked="True"/>
            <RadioButton x:Name="PaintModeMix" Grid.Column="2" Content="Mix" GroupName="PaintMode" Style="{StaticResource EditorRadio}"/>
          </Grid>

          <UniformGrid Columns="2">
            <Button x:Name="Slot0Button" Style="{StaticResource EditorButton}"><TextBlock x:Name="Slot0Text" Text="0" TextAlignment="Center"/></Button>
            <Button x:Name="Slot1Button" Style="{StaticResource EditorButton}"><TextBlock x:Name="Slot1Text" Text="1" TextAlignment="Center"/></Button>
            <Button x:Name="Slot2Button" Style="{StaticResource EditorButton}"><TextBlock x:Name="Slot2Text" Text="2" TextAlignment="Center"/></Button>
            <Button x:Name="Slot3Button" Style="{StaticResource EditorButton}"><TextBlock x:Name="Slot3Text" Text="3" TextAlignment="Center"/></Button>
            <Button x:Name="Slot4Button" Style="{StaticResource EditorButton}"><TextBlock x:Name="Slot4Text" Text="4" TextAlignment="Center"/></Button>
            <Button x:Name="Slot5Button" Style="{StaticResource EditorButton}"><TextBlock x:Name="Slot5Text" Text="5" TextAlignment="Center"/></Button>
            <Button x:Name="Slot6Button" Style="{StaticResource EditorButton}"><TextBlock x:Name="Slot6Text" Text="6" TextAlignment="Center"/></Button>
            <Button x:Name="Slot7Button" Style="{StaticResource EditorButton}"><TextBlock x:Name="Slot7Text" Text="7" TextAlignment="Center"/></Button>
          </UniformGrid>

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="UndoButton" Grid.Column="0" Content="Undo" Style="{StaticResource EditorButton}"/>
            <Button x:Name="SaveButton" Grid.Column="1" Content="Save" Style="{StaticResource EditorButton}"/>
            <Button x:Name="ReloadButton" Grid.Column="2" Content="Reload" Style="{StaticResource EditorButton}"/>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="0" Grid.Column="1" Background="#00000000"/>

    <Border
      x:Name="InspectorPanelBorder"
      Grid.Row="0"
      Grid.Column="2"
      Margin="12,16,0,12"
      CornerRadius="6"
      Padding="14"
      Background="{StaticResource EditorPanelBackground}"
      BorderBrush="{StaticResource EditorPanelBorder}"
      BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Inspector" FontSize="19" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,12"/>
        <Border
          x:Name="InspectorScrollViewport"
          Grid.Row="1"
          Background="#00000000"
          ClipToBounds="True">
          <StackPanel x:Name="InspectorScrollContent" Margin="0,0,6,0">

          <StackPanel x:Name="InspectorContextPanel">
            <TextBlock Text="Name / Folder / Tags" FontSize="12" Foreground="#FFB8C0CF" Margin="0,0,0,2"/>
            <TextBox x:Name="AssetNameBox" Style="{StaticResource EditorTextBox}"/>
            <TextBox x:Name="AssetSubpathBox" Style="{StaticResource EditorTextBox}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="AssetTagsBox" Grid.Column="0" Style="{StaticResource EditorTextBox}"/>
              <Button x:Name="ApplyAssetMetaButton" Grid.Column="1" Content="Apply" Style="{StaticResource EditorButton}"/>
            </Grid>

            <TextBlock Text="Material Editor" FontSize="13" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,10,0,6"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="NewMaterialButton" Grid.Column="0" Content="New" Style="{StaticResource EditorButton}"/>
              <Button x:Name="SaveMaterialButton" Grid.Column="1" Content="Save" Style="{StaticResource EditorButton}"/>
              <Button x:Name="SaveAsMaterialButton" Grid.Column="2" Content="Save As" Style="{StaticResource EditorButton}"/>
              <Button x:Name="LoadMaterialButton" Grid.Column="3" Content="Load" Style="{StaticResource EditorButton}"/>
            </Grid>

            <UniformGrid Columns="2">
              <Button x:Name="MaterialDiffuseButton" Height="42" Style="{StaticResource EditorButton}"><TextBlock x:Name="MaterialDiffuseText" Text="Diffuse: empty" TextAlignment="Center" TextWrapping="Wrap"/></Button>
              <Button x:Name="MaterialNormalButton" Height="42" Style="{StaticResource EditorButton}"><TextBlock x:Name="MaterialNormalText" Text="Normal: flat" TextAlignment="Center" TextWrapping="Wrap"/></Button>
              <Button x:Name="MaterialAoButton" Height="42" Style="{StaticResource EditorButton}"><TextBlock x:Name="MaterialAoText" Text="AO: default" TextAlignment="Center" TextWrapping="Wrap"/></Button>
              <Button x:Name="MaterialRoughnessButton" Height="42" Style="{StaticResource EditorButton}"><TextBlock x:Name="MaterialRoughnessText" Text="Rough: 0.5" TextAlignment="Center" TextWrapping="Wrap"/></Button>
              <Button x:Name="MaterialMetallicButton" Height="42" Style="{StaticResource EditorButton}"><TextBlock x:Name="MaterialMetallicText" Text="Metal: 0.0" TextAlignment="Center" TextWrapping="Wrap"/></Button>
              <Button x:Name="MaterialHeightButton" Height="42" Style="{StaticResource EditorButton}"><TextBlock x:Name="MaterialHeightText" Text="Height: empty" TextAlignment="Center" TextWrapping="Wrap"/></Button>
            </UniformGrid>

            <TextBlock Text="Tiling X / Tiling Y" FontSize="12" Foreground="#FFB8C0CF" Margin="0,8,0,2"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="MaterialTilingXBox" Grid.Column="0" Style="{StaticResource EditorTextBox}"/>
              <TextBox x:Name="MaterialTilingYBox" Grid.Column="1" Style="{StaticResource EditorTextBox}"/>
            </Grid>

            <TextBlock Text="Normal Strength / Tint" FontSize="12" Foreground="#FFB8C0CF" Margin="0,4,0,2"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="MaterialNormalStrengthBox" Grid.Column="0" Style="{StaticResource EditorTextBox}"/>
              <TextBox x:Name="MaterialTintBox" Grid.Column="1" Style="{StaticResource EditorTextBox}"/>
            </Grid>

            <TextBlock x:Name="MaterialAoStrengthText" Text="AO Strength: 1.0" FontSize="12" Foreground="#FFB8C0CF" Margin="0,4,0,2"/>
            <Slider x:Name="MaterialAoStrengthSlider" Minimum="0" Maximum="2" Value="1" Style="{StaticResource EditorSlider}"/>
            <TextBlock x:Name="MaterialRoughnessStrengthText" Text="Roughness Strength: 1.0" FontSize="12" Foreground="#FFB8C0CF" Margin="0,4,0,2"/>
            <Slider x:Name="MaterialRoughnessStrengthSlider" Minimum="0" Maximum="2" Value="1" Style="{StaticResource EditorSlider}"/>
            <TextBlock x:Name="MaterialMetallicStrengthText" Text="Metallic Strength: 1.0" FontSize="12" Foreground="#FFB8C0CF" Margin="0,4,0,2"/>
            <Slider x:Name="MaterialMetallicStrengthSlider" Minimum="0" Maximum="2" Value="1" Style="{StaticResource EditorSlider}"/>
          </StackPanel>

          <StackPanel x:Name="LightingPanel" Visibility="Collapsed">
          <Button x:Name="LightingMainSectionButton" Content="[v] Lighting" Style="{StaticResource EditorButton}" HorizontalContentAlignment="Left"/>
          <StackPanel x:Name="LightingMainSection">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="LightingDawnButton" Grid.Column="0" Content="Dawn" Style="{StaticResource EditorButton}"/>
            <Button x:Name="LightingNoonButton" Grid.Column="1" Content="Noon" Style="{StaticResource EditorButton}"/>
            <Button x:Name="LightingDuskButton" Grid.Column="2" Content="Dusk" Style="{StaticResource EditorButton}"/>
            <Button x:Name="LightingNightButton" Grid.Column="3" Content="Night" Style="{StaticResource EditorButton}"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="LightingSunEnabledButton" Grid.Column="0" Content="Sun: ON" Style="{StaticResource EditorButton}"/>
            <Button x:Name="SunShadowsButton" Grid.Column="1" Content="Shadows: ON" Style="{StaticResource EditorButton}"/>
            <Button x:Name="LightingResetButton" Grid.Column="2" Content="Reset" Style="{StaticResource EditorButton}"/>
          </Grid>

          <TextBlock x:Name="LightingAzimuthText" Text="Azimuth: 60 deg" FontSize="12" Foreground="#FFB8C0CF" Margin="0,4,0,2"/>
          <Slider x:Name="LightingAzimuthSlider" Minimum="0" Maximum="360" Value="60" Style="{StaticResource EditorSlider}"/>
          <TextBlock x:Name="LightingElevationText" Text="Elevation: 60 deg" FontSize="12" Foreground="#FFB8C0CF" Margin="0,4,0,2"/>
          <Slider x:Name="LightingElevationSlider" Minimum="0" Maximum="90" Value="60" Style="{StaticResource EditorSlider}"/>
          <TextBlock x:Name="LightingSunIntensityText" Text="Sun Intensity: 1.0" FontSize="12" Foreground="#FFB8C0CF" Margin="0,4,0,2"/>
          <Slider x:Name="LightingSunIntensitySlider" Minimum="0" Maximum="5" Value="1" Style="{StaticResource EditorSlider}"/>
          <TextBlock x:Name="LightingSunRText" Text="Sun R: 1.00" FontSize="12" Foreground="#FFB8C0CF" Margin="0,4,0,2"/>
          <Slider x:Name="LightingSunRSlider" Minimum="0" Maximum="1" Value="1" Style="{StaticResource EditorSlider}"/>
          <TextBlock x:Name="LightingSunGText" Text="Sun G: 0.95" FontSize="12" Foreground="#FFB8C0CF" Margin="0,4,0,2"/>
          <Slider x:Name="LightingSunGSlider" Minimum="0" Maximum="1" Value="0.95" Style="{StaticResource EditorSlider}"/>
          <TextBlock x:Name="LightingSunBText" Text="Sun B: 0.85" FontSize="12" Foreground="#FFB8C0CF" Margin="0,4,0,2"/>
          <Slider x:Name="LightingSunBSlider" Minimum="0" Maximum="1" Value="0.85" Style="{StaticResource EditorSlider}"/>
          <TextBlock x:Name="LightingAmbientIntensityText" Text="Ambient Intensity: 1.0" FontSize="12" Foreground="#FFB8C0CF" Margin="0,8,0,2"/>
          <Slider x:Name="LightingAmbientIntensitySlider" Minimum="0" Maximum="3" Value="1" Style="{StaticResource EditorSlider}"/>
          <TextBlock x:Name="LightingAmbientRText" Text="Ambient R: 0.15" FontSize="12" Foreground="#FFB8C0CF" Margin="0,4,0,2"/>
          <Slider x:Name="LightingAmbientRSlider" Minimum="0" Maximum="1" Value="0.15" Style="{StaticResource EditorSlider}"/>
          <TextBlock x:Name="LightingAmbientGText" Text="Ambient G: 0.18" FontSize="12" Foreground="#FFB8C0CF" Margin="0,4,0,2"/>
          <Slider x:Name="LightingAmbientGSlider" Minimum="0" Maximum="1" Value="0.18" Style="{StaticResource EditorSlider}"/>
          <TextBlock x:Name="LightingAmbientBText" Text="Ambient B: 0.25" FontSize="12" Foreground="#FFB8C0CF" Margin="0,4,0,2"/>
          <Slider x:Name="LightingAmbientBSlider" Minimum="0" Maximum="1" Value="0.25" Style="{StaticResource EditorSlider}"/>

          </StackPanel>

          <Button x:Name="DynamicLightsSectionButton" Content="[>] Dynamic Lights" Style="{StaticResource EditorButton}" HorizontalContentAlignment="Left" Margin="0,8,6,6"/>
          <StackPanel x:Name="DynamicLightsSection" Visibility="Collapsed">
          <TextBlock x:Name="DynamicLightCountText" Text="Active: 0 / 16" FontSize="12" Foreground="#FFB8C0CF" Margin="0,0,0,4"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="AddPointLightButton" Grid.Column="0" Content="+ Point Light" Style="{StaticResource EditorButton}"/>
            <Button x:Name="AddSpotLightButton" Grid.Column="1" Content="+ Spot Light" Style="{StaticResource EditorButton}"/>
          </Grid>

          </StackPanel>

          <Button x:Name="SelectedLightSectionButton" Content="[>] Selected Light" Style="{StaticResource EditorButton}" HorizontalContentAlignment="Left" Margin="0,8,6,6"/>
          <StackPanel x:Name="SelectedLightSection" Visibility="Collapsed">
          <TextBlock x:Name="SelectedLightTitleText" Text="No light selected" FontSize="13" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,10,0,4"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="SelectedLightEnabledButton" Grid.Column="0" Content="Light: ON" Style="{StaticResource EditorButton}"/>
