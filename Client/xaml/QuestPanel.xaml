<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  TextElement.FontFamily="fonts/#Roboto">
  <Grid.Background>
    <SolidColorBrush Color="#00000000"/>
  </Grid.Background>

  <Grid.Resources>
    <Style x:Key="QuestListBox" TargetType="ListBox">
      <Setter Property="FontFamily" Value="fonts/#Roboto"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="Background" Value="#FF121926"/>
      <Setter Property="BorderBrush" Value="#55758AA8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border
              CornerRadius="6"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer Padding="{TemplateBinding Padding}">
                <ItemsPresenter/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuestListBoxItem" TargetType="ListBoxItem">
      <Setter Property="FontFamily" Value="fonts/#Roboto"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border
              x:Name="Chrome"
              CornerRadius="6"
              Padding="12"
              Background="#FF1C2534"
              BorderBrush="#334D6384"
              BorderThickness="1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FF243147"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#667CA0D4"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FF2F3F5C"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF6EA7FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Border
    Width="720"
    HorizontalAlignment="Right"
    VerticalAlignment="Center"
    Margin="0,0,28,0"
    CornerRadius="8"
    Background="#DD1A1A22"
    BorderBrush="#66FFFFFF"
    BorderThickness="1"
    Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock
        Text="Questek"
        Margin="0,0,0,16"
        FontFamily="fonts/#Roboto"
        FontSize="24"
        FontWeight="Bold"
        Foreground="#FFFFFFFF"/>

      <Grid Grid.Row="1" MinHeight="300" MaxHeight="540">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox
          ItemsSource="{Binding Quests}"
          SelectedItem="{Binding SelectedQuest, Mode=TwoWay}"
          Style="{StaticResource QuestListBox}"
          ItemContainerStyle="{StaticResource QuestListBoxItem}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock
                  Text="{Binding Title}"
                  FontFamily="fonts/#Roboto"
                  FontSize="15"
                  FontWeight="Bold"
                  Foreground="#FFFFFFFF"
                  TextWrapping="Wrap"/>
                <TextBlock
                  Text="{Binding CounterText}"
                  Margin="0,6,0,0"
                  FontFamily="fonts/#Roboto"
                  FontSize="12"
                  Foreground="#FFB8C0CF"
                  TextWrapping="Wrap"/>
                <TextBlock
                  Text="{Binding ClockText}"
                  Margin="0,4,0,0"
                  FontFamily="fonts/#Roboto"
                  FontSize="12"
                  Foreground="#FF9AB4D6"
                  TextWrapping="Wrap"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border
          Grid.Column="1"
          Margin="14,0"
          Background="#44758AA8"/>

        <Border
          Grid.Column="2"
          CornerRadius="6"
          Background="#AA121926"
          BorderBrush="#334D6384"
          BorderThickness="1"
          Padding="18">
          <StackPanel>
            <TextBlock
              Text="{Binding DetailTitle}"
              FontFamily="fonts/#Roboto"
              FontSize="22"
              FontWeight="Bold"
              Foreground="#FFFFFFFF"
              TextWrapping="Wrap"/>

            <TextBlock
              Text="{Binding DetailProgress}"
              Margin="0,18,0,0"
              FontFamily="fonts/#Roboto"
              FontSize="15"
              Foreground="#FFE1E7F2"
              TextWrapping="Wrap"/>

            <TextBlock
              Text="{Binding DetailTimeRemaining}"
              Margin="0,10,0,0"
              FontFamily="fonts/#Roboto"
              FontSize="15"
              Foreground="#FF9AB4D6"
              TextWrapping="Wrap"/>

            <TextBlock
              Text="{Binding DetailIconFile}"
              Margin="0,22,0,0"
              FontFamily="fonts/#Roboto"
              FontSize="12"
              Foreground="#FF7D8798"
              TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Grid>
