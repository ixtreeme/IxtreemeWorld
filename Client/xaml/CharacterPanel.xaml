<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  TextElement.FontFamily="fonts/#Roboto">
  <Grid.Background>
    <SolidColorBrush Color="#00000000"/>
  </Grid.Background>

  <Grid.Resources>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="fonts/#Roboto"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="LabelText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="fonts/#Roboto"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#FFB8C0CF"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ValueText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="fonts/#Roboto"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#FFEAF0FA"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="StatButton" TargetType="Button">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="FontFamily" Value="fonts/#Roboto"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="4,2,0,2"/>
    </Style>
  </Grid.Resources>

  <Border
    Width="430"
    HorizontalAlignment="Left"
    VerticalAlignment="Center"
    Margin="28,0,0,0"
    CornerRadius="8"
    Background="#DD1A1A22"
    BorderBrush="#66FFFFFF"
    BorderThickness="1"
    Padding="18">
    <StackPanel>
      <TextBlock
        Text="Karakter"
        Margin="0,0,0,16"
        FontFamily="fonts/#Roboto"
        FontSize="24"
        FontWeight="Bold"
        Foreground="#FFFFFFFF"/>

      <Border
        CornerRadius="6"
        Background="#AA121926"
        BorderBrush="#334D6384"
        BorderThickness="1"
        Padding="14"
        Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="110"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Style="{StaticResource LabelText}" Text="Level"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Level}"/>
          <TextBlock Grid.Row="1" Style="{StaticResource LabelText}" Text="EXP"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Exp}"/>
          <TextBlock Grid.Row="2" Style="{StaticResource LabelText}" Text="Necessary EXP"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding NextExp}"/>
        </Grid>
      </Border>

      <Border
        CornerRadius="6"
        Background="#AA121926"
        BorderBrush="#334D6384"
        BorderThickness="1"
        Padding="14"
        Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="Character Status"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="112"/>
              <ColumnDefinition Width="48"/>
              <ColumnDefinition Width="26"/>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="72"/>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="26"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="24"/>
              <RowDefinition Height="24"/>
              <RowDefinition Height="24"/>
              <RowDefinition Height="24"/>
              <RowDefinition Height="24"/>
              <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource LabelText}" Text="VIT"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Vit}"/>
            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource StatButton}" Content="+" Command="{Binding VitCommand}" IsEnabled="{Binding CanStatUp}"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource LabelText}" Text="INT"/>
            <TextBlock Grid.Row="0" Grid.Column="5" Style="{StaticResource ValueText}" Text="{Binding Int}"/>
            <Button Grid.Row="0" Grid.Column="6" Style="{StaticResource StatButton}" Content="+" Command="{Binding IntCommand}" IsEnabled="{Binding CanStatUp}"/>

            <TextBlock Grid.Row="1" Style="{StaticResource LabelText}" Text="STR"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Str}"/>
            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource StatButton}" Content="+" Command="{Binding StrCommand}" IsEnabled="{Binding CanStatUp}"/>
            <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource LabelText}" Text="DEX"/>
            <TextBlock Grid.Row="1" Grid.Column="5" Style="{StaticResource ValueText}" Text="{Binding Dex}"/>
            <Button Grid.Row="1" Grid.Column="6" Style="{StaticResource StatButton}" Content="+" Command="{Binding DexCommand}" IsEnabled="{Binding CanStatUp}"/>

            <TextBlock Grid.Row="2" Style="{StaticResource LabelText}" Text="Available"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding StatPoints}"/>

            <TextBlock Grid.Row="3" Style="{StaticResource LabelText}" Text="HP"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="6" Style="{StaticResource ValueText}" Text="{Binding Hp}"/>

            <TextBlock Grid.Row="4" Style="{StaticResource LabelText}" Text="SP"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="6" Style="{StaticResource ValueText}" Text="{Binding Sp}"/>

            <TextBlock Grid.Row="5" Style="{StaticResource LabelText}" Text="Attack Damage"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding AttackDamage}"/>
            <TextBlock Grid.Row="5" Grid.Column="4" Style="{StaticResource LabelText}" Text="Defence"/>
            <TextBlock Grid.Row="5" Grid.Column="5" Grid.ColumnSpan="2" Style="{StaticResource ValueText}" Text="{Binding Defence}"/>
          </Grid>
        </StackPanel>
      </Border>

      <Border
        CornerRadius="6"
        Background="#AA121926"
        BorderBrush="#334D6384"
        BorderThickness="1"
        Padding="14">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="Attributes"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="24"/>
              <RowDefinition Height="24"/>
              <RowDefinition Height="24"/>
              <RowDefinition Height="24"/>
              <RowDefinition Height="24"/>
              <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource LabelText}" Text="Moving Speed"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding MovingSpeed}"/>
            <TextBlock Grid.Row="1" Style="{StaticResource LabelText}" Text="Attack Rate"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding AttackRate}"/>
            <TextBlock Grid.Row="2" Style="{StaticResource LabelText}" Text="Casting Speed"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding CastingSpeed}"/>
            <TextBlock Grid.Row="3" Style="{StaticResource LabelText}" Text="Magic Damage"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding MagicDamage}"/>
            <TextBlock Grid.Row="4" Style="{StaticResource LabelText}" Text="Magic Defence"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding MagicDefence}"/>
            <TextBlock Grid.Row="5" Style="{StaticResource LabelText}" Text="Evading"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Evading}"/>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Grid>
